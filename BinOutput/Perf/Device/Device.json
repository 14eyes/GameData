{
  "$type": "CPOOLEJIHDC",
  "perfConfigs": [
    {
      "$type": "CPOOLEJIHDC",
      "command": [
        "graphicsSetting.newCrowdActive=false",
        "engine.invalidGameplayTransformValueThreshold=10000000"
      ]
    },
    {
      "$type": "CPOOLEJIHDC",
      "perfConfigs": [
        {
          "$type": "CPOOLEJIHDC",
          "command": [
            "textureStreaming.textureStreamingBudget.max=70"
          ],
          "condition": "Device [iPadMini5Gen,iPad7Gen,iPad8Gen,iPad9Gen,iPadAir3Gen]"
        }
      ],
      "command": [
        "engine.keepPrefabMeshFromMeshGC=false",
        "animation.compressionCacheBudget=1048576",
        "animation.compressionThreshold=524288",
        "animation.aclDatabaseLRUSize=2097152",
        "resource.lruRetireAll=true",
        "qualitySettings.avatarLodLevelDownEnable=true",
        "qualitySettings.avatarLodLevelDownValue=1"
      ],
      "condition": "Platform == IOS"
    },
    {
      "$type": "CPOOLEJIHDC",
      "perfConfigs": [
        {
          "$type": "CPOOLEJIHDC",
          "command": [
            "graphicsSetting.isAllowVulkanDevice=true"
          ],
          "condition": "GraphicsDeviceName [Adreno.*730,Adreno.*740,Adreno.*750,Mali.*G710,Mali.*G715,Mali.*G720]"
        }
      ],
      "command": [
        "engine.keepPrefabMeshFromMeshGC=false",
        "animation.compressionCacheBudget=1048576",
        "animation.compressionThreshold=524288",
        "animation.aclDatabaseLRUSize=2097152",
        "qualitySettings.avatarLodLevelDownEnable=true",
        "qualitySettings.avatarLodLevelDownValue=1"
      ],
      "condition": "Platform == Android || Platform == OpenHarmony"
    },
    {
      "$type": "CPOOLEJIHDC",
      "perfConfigs": [
        {
          "$type": "CPOOLEJIHDC",
          "command": [
            "nativeConfig.pool.Debug.cacheLevel=Compress",
            "nativeConfig.pool.Debug.autoCache=true"
          ]
        }
      ],
      "condition": "Platform == PS4"
    },
    {
      "$type": "CPOOLEJIHDC",
      "perfConfigs": [
        {
          "$type": "CPOOLEJIHDC",
          "command": [
            "resource.maxAssetBundleCacheSizeMB=12000",
            "resource.assetBundleUnloadWarnningMemoryMB=11000"
          ]
        }
      ],
      "condition": "Platform == PS5"
    },
    {
      "$type": "CPOOLEJIHDC",
      "perfConfigs": [
        {
          "$type": "CPOOLEJIHDC",
          "command": [
            "animation.compressionCacheBudget=2097152",
            "animation.compressionThreshold=1048576",
            "animation.aclDatabaseLRUSize=4194304",
            "globalVars.useMoreCache=false",
            "qualitySettings.heightfieldDeformationQuality=1",
            "preload.enablePreloadGadgetConfig=false",
            "resource.maxAssetBundleCacheSizeMB=0",
            "resource.assetBundleUnloadWarnningMemoryMB=0",
            "resource.lruRetireAll=true"
          ],
          "condition": "Device == SeriesS"
        }
      ],
      "condition": "Platform == Xbox"
    }
  ]
}