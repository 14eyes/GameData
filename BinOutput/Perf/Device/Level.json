{
  "$type": "CPOOLEJIHDC",
  "perfConfigs": [
    {
      "$type": "CPOOLEJIHDC",
      "perfConfigs": [
        {
          "$type": "CPOOLEJIHDC",
          "command": [
            "sectr.disableLSOLyaer=true"
          ],
          "condition": "Memory == VeryLow || Memory == Low"
        }
      ],
      "command": [
        "sectr.stoneTintTexelWorldSize=2",
        "sectr.stoneTintSplitTextureWidth=128"
      ],
      "condition": "Platform [IOS,Android,OpenHarmony]"
    },
    {
      "$type": "CPOOLEJIHDC",
      "command": [
        "sectr.stoneTintTexelWorldSize=1",
        "sectr.stoneTintSplitTextureWidth=256"
      ],
      "condition": "Platform [PS5,PS4,PC,Xbox]"
    },
    {
      "$type": "CPOOLEJIHDC",
      "command": [
        "sectr.stoneTintExpectedHighPrecisionRange=384",
        "sectr.stoneTintExpectedRange=1536"
      ],
      "condition": "SectrProfileName [AndroidDefault_High,AndroidDefault_Low,AndroidDefault_Middle,AndroidDefault_VeryLow]"
    },
    {
      "$type": "CPOOLEJIHDC",
      "command": [
        "sectr.stoneTintExpectedHighPrecisionRange=384",
        "sectr.stoneTintExpectedRange=1536"
      ],
      "condition": "SectrProfileName [iOSDefault,iOSDefault_Low,iOSDefault_Middle,iOSDefault_VeryLow]"
    },
    {
      "$type": "CPOOLEJIHDC",
      "command": [
        "sectr.stoneTintExpectedHighPrecisionRange=512",
        "sectr.stoneTintExpectedRange=2048"
      ],
      "condition": "SectrProfileName == iOSDefault_High"
    },
    {
      "$type": "CPOOLEJIHDC",
      "command": [
        "sectr.stoneTintExpectedHighPrecisionRange=768",
        "sectr.stoneTintExpectedRange=3072"
      ],
      "condition": "SectrProfileName [PCDefault,PC_VeryLow,PC_Low,PC_Middle,PC_High]"
    },
    {
      "$type": "CPOOLEJIHDC",
      "command": [
        "sectr.stoneTintExpectedHighPrecisionRange=1024",
        "sectr.stoneTintExpectedRange=4608"
      ],
      "condition": "SectrProfileName == PC_VeryHigh"
    },
    {
      "$type": "CPOOLEJIHDC",
      "command": [
        "sectr.stoneTintExpectedHighPrecisionRange=512",
        "sectr.stoneTintExpectedRange=1536"
      ],
      "condition": "SectrProfileName == PS4_Base"
    },
    {
      "$type": "CPOOLEJIHDC",
      "command": [
        "sectr.stoneTintExpectedHighPrecisionRange=512",
        "sectr.stoneTintExpectedRange=2560"
      ],
      "condition": "SectrProfileName == PS4_Pro"
    },
    {
      "$type": "CPOOLEJIHDC",
      "command": [
        "sectr.stoneTintExpectedHighPrecisionRange=768",
        "sectr.stoneTintExpectedRange=3584"
      ],
      "condition": "SectrProfileName == PS5"
    },
    {
      "$type": "CPOOLEJIHDC",
      "command": [
        "sectr.stoneTintExpectedHighPrecisionRange=768",
        "sectr.stoneTintExpectedRange=3584"
      ],
      "condition": "SectrProfileName [XBox_SeriesS,XBox_SeriesX]"
